#!/usr/bin/env bash
# Create a Chrome launcher backed by its own fresh --user-data-dir, so it runs
# as a separate process with its own WM class (separate dock icon/grouping).
# Nothing is copied from ~/.config/google-chrome; sign in on first launch.

set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] NAME

  NAME             short id, e.g. "work" -> chrome-work.desktop
                   data dir: ~/.config/chrome-instances/NAME

Options:
  -l, --label TEXT  menu label suffix (default: NAME) -> "Chrome - TEXT"
  -i, --icon FILE   use this image as the icon instead of the Chrome logo
  -r, --recolor     only redraw NAME's icon in the theme color picked in that
                    Chrome (Customize Chrome > Color)
  -f, --force       overwrite an existing launcher/icon (data dir is kept)
  -d, --delete      remove NAME's launcher, icon and data dir, confirming each
  -h, --help        show this help

Environment:
  CHROME_BIN        Chrome executable (default: /usr/bin/google-chrome-stable)
  CHROME_LOGO       logo to recolor (default: /opt/google/chrome/product_logo_256.png)
EOF
}

die() { echo "$(basename "$0"): $*" >&2; exit 1; }
need_arg() { (($# >= 2)) || die "$1 needs a value"; }

label="" icon_src="" recolor=0 force=0 delete=0 args=()
while (($#)); do
    case $1 in
        -l|--label) need_arg "$@"; label=$2; shift 2 ;;
        -i|--icon)  need_arg "$@"; icon_src=$2; shift 2 ;;
        -r|--recolor) recolor=1; shift ;;
        -f|--force)   force=1; shift ;;
        -d|--delete)  delete=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)  args+=("$1"); shift ;;
    esac
done
((${#args[@]} == 1)) || { usage >&2; exit 1; }

name=${args[0]}
[[ $name =~ ^[A-Za-z0-9_-]+$ ]] || die "NAME may only contain letters, digits, - and _"
if ((recolor)) && [[ -n $label || -n $icon_src ]]; then
    die "--recolor only changes the icon; use --force to change the label or icon file"
fi
label=${label:-$name}

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
# The data dir lives under ~/.config like Chrome's own: only then does Chrome
# put its disk cache under ~/.cache (same relative path) instead of inside it.
profile_dir=${XDG_CONFIG_HOME:-$HOME/.config}/chrome-instances/$name
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/chrome-instances/$name
desktop_file=$data_home/applications/chrome-$name.desktop
icon_file=$data_home/icons/chrome-$name.png
wm_class=chrome-$name
chrome_bin=${CHROME_BIN:-/usr/bin/google-chrome-stable}
logo=${CHROME_LOGO:-/opt/google/chrome/product_logo_256.png}
# Prefer the system convert: a magick earlier in PATH may be a container
# wrapper (apx/distrobox) that can't see host paths like /opt.
im=$(command -v convert || command -v magick) || im=""

confirm() {
    local reply
    read -r -p "$1 [y/N] " reply || reply=""
    [[ $reply == [yY] || $reply == [yY][eE][sS] ]]
}

# Chrome keeps a SingletonLock symlink in its data dir pointing at "<host>-<pid>".
# kill -0 skips a stale lock left behind by a crash.
chrome_running() {
    local lock
    lock=$(readlink "$profile_dir/SingletonLock" 2>/dev/null) && kill -0 "${lock##*-}" 2>/dev/null
}

# GNOME Shell caches icons by path and doesn't watch the icon files, so an
# icon rewritten in place stays stale. It does rescan icon directories whose
# mtime changed, which also drops the cached icons, so bump the directory's.
refresh_icon_cache() {
    touch "$(dirname "$icon_file")"
}

# Draw the Chrome logo with its red/green/yellow segments replaced by the
# Material tones Chrome derives from the profile's theme color, the same
# palette Chrome paints its own frame with. The blue center and white ring are
# kept. Prints what it used; exits 3 when the profile has no theme color.
theme_icon() {
    python3 - "$im" "$logo" "$profile_dir" "$icon_file" <<'PY'
import json, math, os, subprocess, sys

im, logo, data_dir, out = sys.argv[1:5]

def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(3)

def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None

state = load(os.path.join(data_dir, "Local State")) or {}
profile = state.get("profile", {}).get("last_used") or "Default"
prefs = load(os.path.join(data_dir, profile, "Preferences"))
if prefs is None:
    fail(f"no Chrome profile in {data_dir} yet; launch it and pick a color first")
theme = prefs.get("browser", {}).get("theme", {})
ext_theme = prefs.get("extensions", {}).get("theme", {})
if ext_theme.get("system_theme", 0):
    fail(f'profile "{profile}" uses the GTK/Qt system theme, which has no theme color')
theme_id = ext_theme.get("id", "")
if theme_id == "autogenerated_theme_id":
    seed = prefs.get("autogenerated", {}).get("theme", {}).get("color")
elif theme_id in ("", "user_color_theme_id"):
    seed = theme.get("user_color")
else:
    fail(f'profile "{profile}" uses a theme extension, which has no theme color')
grayscale = theme.get("is_grayscale", False)
if seed is None and not grayscale:
    fail(f'profile "{profile}" has no theme color; pick one in Customize Chrome > Color')
if theme.get("color_variant", 1) not in (0, 1):
    print("note: only Chrome's default color style is reproduced exactly", file=sys.stderr)

# --- Material HCT (CAM16 hue/chroma + L* tone), after material-color-utilities
def lin(c):
    c /= 255
    return (c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4) * 100

def delin(c):
    c /= 100
    v = c * 12.92 if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055
    return max(0, min(255, round(v * 255)))

def mul(m, v):
    return [sum(m[i][j] * v[j] for j in range(3)) for i in range(3)]

def y_from_lstar(l):
    return 100 * (((l + 16) / 116) ** 3 if l > 8 else l / 903.2962962962963)

def lstar_from_y(y):
    y /= 100
    return 116 * y ** (1 / 3) - 16 if y > 216 / 24389 else 24389 / 27 * y

SRGB_XYZ = [[0.41233895, 0.35762064, 0.18051042], [0.2126, 0.7152, 0.0722],
            [0.01932141, 0.11916382, 0.95034478]]
XYZ_SRGB = [[3.2413774792388685, -1.5376652402851851, -0.49885366846268053],
            [-0.9691452513005321, 1.8758853451067872, 0.04156585616912061],
            [0.05562093689691305, -0.20395524564742123, 1.0571799111220335]]
M16 = [[0.401288, 0.650173, -0.051461], [-0.250268, 1.204414, 0.045854],
       [-0.002079, 0.048952, 0.953127]]
M16_INV = [[1.8620678, -1.0112547, 0.14918678], [0.38752654, 0.62144744, -0.00897398],
           [-0.01584150, -0.03412294, 1.0499644]]

# Default viewing conditions (D65, background L* 50, average surround)
LA = 200 / math.pi * y_from_lstar(50) / 100
RGB_W = mul(M16, [95.047, 100.0, 108.883])
D = max(0, min(1, 1 - (1 / 3.6) * math.exp((-LA - 42) / 92)))
DR = [D * 100 / w + 1 - D for w in RGB_W]
K4 = (1 / (5 * LA + 1)) ** 4
FL = K4 * LA + 0.1 * (1 - K4) ** 2 * (5 * LA) ** (1 / 3)
N = y_from_lstar(50) / 100
Z = 1.48 + math.sqrt(N)
NBB = 0.725 / N ** 0.2
C_SURR = 0.69
AF_W = [(FL * DR[i] * RGB_W[i] / 100) ** 0.42 for i in range(3)]
A_W = (2 * (400 * AF_W[0] / (AF_W[0] + 27.13)) + 400 * AF_W[1] / (AF_W[1] + 27.13)
       + 0.05 * 400 * AF_W[2] / (AF_W[2] + 27.13)) * NBB

def hue_of(rgb):
    rd = [DR[i] * c for i, c in enumerate(mul(M16, mul(SRGB_XYZ, [lin(c) for c in rgb])))]
    af = [(FL * abs(x) / 100) ** 0.42 for x in rd]
    ra = [math.copysign(400 * f / (f + 27.13), x) for f, x in zip(af, rd)]
    return math.degrees(math.atan2((ra[0] + ra[1] - 2 * ra[2]) / 9,
                                   (11 * ra[0] - 12 * ra[1] + ra[2]) / 11)) % 360

def xyz_from_jch(j, c, h):
    t = (c / math.sqrt(j / 100) / (1.64 - 0.29 ** N) ** 0.73) ** (1 / 0.9) if c and j else 0
    hr = math.radians(h)
    p1 = 0.25 * (math.cos(hr + 2) + 3.8) * (50000 / 13) * NBB
    p2 = A_W * (j / 100) ** (1 / C_SURR / Z) / NBB
    gamma = 23 * (p2 + 0.305) * t / (23 * p1 + 11 * t * math.cos(hr) + 108 * t * math.sin(hr))
    a, b = gamma * math.cos(hr), gamma * math.sin(hr)
    ra = [(460 * p2 + 451 * a + 288 * b) / 1403, (460 * p2 - 891 * a - 261 * b) / 1403,
          (460 * p2 - 220 * a - 6300 * b) / 1403]
    rc = [math.copysign(100 / FL * max(0, 27.13 * abs(x) / (400 - abs(x))) ** (1 / 0.42), x) / DR[i]
          for i, x in enumerate(ra)]
    return mul(M16_INV, rc)

def find_by_j(h, c, tone):
    lo, hi, best, target = 0.0, 100.0, None, y_from_lstar(tone)
    for _ in range(40):
        mid = (lo + hi) / 2
        xyz = xyz_from_jch(mid, c, h)
        if (abs(lstar_from_y(max(xyz[1], 0)) - tone) < 0.2
                and all(-0.01 <= v <= 100.01 for v in mul(XYZ_SRGB, xyz))):
            best = xyz
        lo, hi = (mid, hi) if xyz[1] < target else (lo, mid)
    return best

def from_hct(h, c, tone):
    """sRGB for hue/chroma/tone, lowering chroma until it fits in sRGB."""
    xyz = find_by_j(h, c, tone) if c >= 0.5 else None
    if xyz is None and c >= 0.5:
        lo, hi = 0.0, c  # bisect for the highest chroma that fits
        while hi - lo > 0.1:
            mid = (lo + hi) / 2
            found = find_by_j(h, mid, tone)
            if found:
                xyz, lo = found, mid
            else:
                hi = mid
    if xyz is None:
        return (delin(y_from_lstar(tone)),) * 3
    return tuple(delin(v) for v in mul(XYZ_SRGB, xyz))

# Chrome's default ("tonal spot") palette: primary = seed hue at chroma 40,
# secondary = chroma 16. Grayscale themes have no chroma.
if grayscale:
    hue, c1, c2, what = 0, 0, 0, "grayscale theme"
else:
    seed &= 0xFFFFFF
    hue, c1, c2 = hue_of(((seed >> 16) & 255, (seed >> 8) & 255, seed & 255)), 40, 16
    what = f"theme #{seed:06X}"
colors = [(255, 255, 255),       # white ring
          from_hct(hue, c1, 30),  # top (red) segment
          from_hct(hue, c1, 80),  # bottom-left (green) segment
          from_hct(hue, c2, 50)]  # right (yellow) segment

# --- Paint the segments. On the 256px logo the outer radius is 128 and the
# white ring's outer radius is 64; each segment boundary is a line tangent to
# the ring, so at radius rho the segments are 120 degree arcs rotated by
# atan(sqrt(rho^2 - 64^2) / 64). 4x4 supersampling anti-aliases the edges.
size, cx, r1, ss = 256, 128.0, 64.0, 4
px = bytearray(subprocess.run([im, logo, "-resize", f"{size}x{size}!", "-depth", "8", "rgba:-"],
                              capture_output=True, check=True).stdout)
offsets = [(i + 0.5) / ss for i in range(ss)]
for y in range(size):
    for x in range(size):
        i = (y * size + x) * 4
        if px[i + 3] == 0:
            continue
        count = [0, 0, 0, 0]
        for oy in offsets:
            for ox in offsets:
                dx, dy = x + ox - cx, cx - (y + oy)
                rho = math.hypot(dx, dy)
                if rho < r1:
                    count[0] += 1
                else:
                    turn = math.degrees(math.atan2(dy, dx) + math.atan(math.sqrt(rho * rho - r1 * r1) / r1))
                    count[1 + int(((turn - 90) % 360) // 120)] += 1
        if count[0] == ss * ss:
            continue  # inside the ring: keep the logo's own pixels
        for ch in range(3):
            px[i + ch] = round(sum(n * col[ch] for n, col in zip(count, colors)) / (ss * ss))
subprocess.run([im, "-size", f"{size}x{size}", "-depth", "8", "rgba:-", out], input=bytes(px), check=True)
print(f'{what} from profile "{profile}"')
PY
}

if ((delete)); then
    if chrome_running; then
        die "Chrome is running with $profile_dir; close it first."
    fi
    found=0
    for target in "$desktop_file" "$icon_file" "$profile_dir" "$cache_dir"; do
        [[ -e $target ]] || continue
        found=1
        if [[ $target == "$cache_dir" ]]; then
            desc="cache $target ($(du -sh "$target" | cut -f1))"
        elif [[ -d $target ]]; then
            desc="data directory $target ($(du -sh "$target" | cut -f1); logins, history, profiles)"
        else
            desc="$target"
        fi
        if confirm "Delete $desc?"; then
            rm -rf -- "$target"
            echo "  deleted"
        else
            echo "  kept"
        fi
    done
    ((found)) || die "Nothing found for '$name'."
    update-desktop-database "$(dirname "$desktop_file")" 2>/dev/null || true
    exit 0
fi

if ((recolor)); then
    [[ -e $desktop_file ]] || die "no launcher for '$name' (create it first)"
    command -v python3 >/dev/null || die "python3 is needed for --recolor"
    [[ -n $im ]] || die "ImageMagick is needed for --recolor"
    [[ -f $logo ]] || die "Chrome logo not found at $logo (set CHROME_LOGO)"
    used=$(theme_icon) || exit 1
    refresh_icon_cache
    echo "Icon:      $icon_file ($used)"
    echo "The dock picks it up within a few seconds (or when you open the overview)."
    exit 0
fi

# Check everything before creating anything, so a bad option leaves no debris.
if ((!force)); then
    for f in "$desktop_file" "$icon_file"; do
        if [[ -e $f ]]; then
            die "$f already exists (use --force to overwrite)"
        fi
    done
fi
[[ -x $chrome_bin ]] || die "Chrome not found at $chrome_bin (set CHROME_BIN)"
if [[ -n $icon_src ]]; then
    [[ -f $icon_src ]] || die "icon not found: $icon_src"
else
    [[ -f $logo ]] || die "Chrome logo not found at $logo (set CHROME_LOGO or use --icon)"
fi

# A brand-new data dir gets its profile folder named NAME instead of "Default".
# Chrome names web app launchers and their Wayland app_id
# chrome-<app-id>-<profile folder>, so this keeps the same app installed from
# two launchers from overwriting each other's launcher or sharing a dock icon.
fresh=0
[[ -d $profile_dir && -n $(ls -A "$profile_dir") ]] || fresh=1

mkdir -p "$profile_dir" "$(dirname "$desktop_file")" "$(dirname "$icon_file")"

if ((fresh)); then
    printf '{"profile":{"last_used":"%s"}}\n' "$name" >"$profile_dir/Local State"
fi

# Icon: explicit file (converted to PNG when possible), else the profile's
# theme colors if an existing data dir has them, else the stock logo
if [[ -n $icon_src ]]; then
    if [[ -n $im ]]; then
        "$im" "$icon_src[0]" "$icon_file"
    else
        cp -- "$icon_src" "$icon_file"
    fi
    icon_desc="from $icon_src"
elif ((!fresh)) && [[ -n $im ]] && command -v python3 >/dev/null &&
        used=$(theme_icon 2>/dev/null); then
    icon_desc=$used
else
    cp -- "$logo" "$icon_file"
    icon_desc="stock Chrome logo"
fi

# CHROME_DESKTOP tells Chrome which launcher it was started from, so
# "Make default browser" registers this launcher instead of google-chrome.desktop.
cmd="env CHROME_DESKTOP=chrome-$name.desktop $chrome_bin --user-data-dir=\"$profile_dir\" --class=\"$wm_class\""

cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Chrome - $label
GenericName=Web Browser
Comment=Google Chrome ($label profile)
Exec=$cmd %U
Icon=$icon_file
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=$wm_class
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=$cmd

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=$cmd --incognito
EOF

refresh_icon_cache
update-desktop-database "$(dirname "$desktop_file")" 2>/dev/null || true

echo "Launcher:  $desktop_file"
echo "Icon:      $icon_file ($icon_desc)"
if ((fresh)); then
    echo "Data dir:  $profile_dir (new; profile folder \"$name\")"
    echo "Launch it from your app menu and sign in. To match the icon to a theme"
    echo "color, pick one in Customize Chrome > Color, then run:"
    echo "  $(basename "$0") --recolor $name"
else
    echo "Data dir:  $profile_dir (existing; reused as-is)"
fi
